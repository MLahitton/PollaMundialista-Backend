# ============================================================
# Configuracion local del backend - Polla Mundialista 2026
# ============================================================
#
# COMO USARLO
#   1. Copia este archivo como .env en la raiz del backend:
#          Copy-Item .env.example .env        (Windows PowerShell)
#          cp .env.example .env               (macOS / Linux)
#   2. Rellena las variables OBLIGATORIAS de abajo.
#   3. Arranca el backend. No hay que exportar nada a mano.
#
# .env esta en .gitignore y NUNCA debe subirse al repositorio.
# Este archivo (.env.example) si se versiona, y por eso no lleva
# ningun valor real.
#
# Lo carga automaticamente application.properties mediante:
#   spring.config.import=optional:file:./.env[.properties]
#
# IMPORTANTE: no dejes una variable escrita con el valor vacio
# (por ejemplo "DB_URL=") si no vas a darle valor. Un valor vacio
# sobrescribe el valor por defecto del proyecto y puede impedir que
# el backend arranque. Si no la necesitas, dejala comentada.


# ============================================================
# OBLIGATORIAS
# ============================================================

# Contrasena de tu PostgreSQL local, la que definiste al instalarlo.
DB_PASSWORD=

# Secreto INTERNO con el que este backend firma y valida sus propios JWT,
# los que emite despues de validar el Google ID Token.
#
# NO tiene ninguna relacion con Google: no es el Client ID ni el Client Secret.
#
# Requisito (ver AppJwtConfig): Base64 ESTANDAR de al menos 32 bytes.
# Un Client Secret de Google (formato GOCSPX-...) NO sirve y falla con
# "Illegal base64 character 2d", porque el guion no esta en el alfabeto Base64.
#
# Generar uno propio sin imprimirlo en pantalla:
#
#   Windows PowerShell:
#     $bytes = New-Object byte[] 48
#     $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
#     $rng.GetBytes($bytes)
#     "JWT_SECRET=" + [Convert]::ToBase64String($bytes) | Out-File -Append -Encoding ascii .env
#     $rng.Dispose()
#
#   macOS / Linux:
#     echo "JWT_SECRET=$(openssl rand -base64 48)" >> .env
#
# Debe permanecer ESTABLE entre reinicios: si cambia, las sesiones abiertas
# dejan de ser validas y el frontend recibira 401.
JWT_SECRET=


# ============================================================
# OPCIONALES (ya tienen valor por defecto en el proyecto)
#
# Descomenta solo las que necesites cambiar.
# ============================================================

# Google OAuth Web Client ID.
# El proyecto ya trae configurado el Client ID compartido, asi que
# normalmente NO hace falta tocar esto.
# Es un valor PUBLICO: viaja al navegador y no es un secreto.
# Debe coincidir con NEXT_PUBLIC_GOOGLE_CLIENT_ID del frontend.
#
# Este proyecto NO utiliza el Google Client Secret. No lo pongas aqui.
#GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com

# Conexion a PostgreSQL.
# Por defecto: jdbc:postgresql://localhost:5432/polla_mundialista
#DB_URL=jdbc:postgresql://localhost:5432/polla_mundialista

# Usuario de PostgreSQL. Por defecto: postgres
#DB_USERNAME=postgres

# Origenes permitidos por CORS, separados por coma.
# Por defecto: http://localhost:3000
# Anade aqui la IP de tu maquina si quieres abrir el frontend desde
# otro dispositivo de la misma red (por ejemplo un movil).
#CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.100:3000

# Scheduler de scoring automatico. Por defecto: true
# Se recomienda false en desarrollo para que no se puntuen de golpe
# todos los partidos historicos al arrancar.
AUTO_SCORING_ENABLED=false
